# MongoDB Connection URI
dburi=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT Authentication Secret
jwt_secret=your_super_secret_jwt_key_here

# Razorpay Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend URL (Used for production CORS)
CLIENT_URL=http://localhost:5173

# Environment (set to 'production' on Render)
NODE_ENV=development
